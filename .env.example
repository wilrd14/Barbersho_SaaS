# Kortex — variables de entorno de ejemplo (Sprint 1)
# Copia este archivo a .env.local y rellena con los valores de tu proyecto Supabase.
# NUNCA commitees .env.local ni valores reales.

# --- Supabase (publicos, van al bundle del cliente) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (privados, SOLO server-side, jamas en "use client") ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Postgres (Drizzle) ---
# DATABASE_URL: pooler/transaction mode, usado por la app en runtime.
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:6543/postgres?pgbouncer=true
# DIRECT_URL: conexion directa (sin pooler), usada solo para migraciones (drizzle-kit).
DIRECT_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- App ---
# Usado para construir enlaces de auth (confirmacion de correo, recuperar clave).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Observabilidad ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Notificaciones (vacio en Sprint 1, se cablea en sprints posteriores) ---
RESEND_API_KEY=
